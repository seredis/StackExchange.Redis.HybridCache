<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InvalidationDemo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- the REAL shipped stock stack, resolved as a normal consumer would get it (a transitive
         StackExchange.Redis 2.x: the dependency is a >= 2.7.27 floor, and nothing here raises
         it). Kept as a separate project from RedisHybrid so this flavor demonstrably runs the
         stock stack as shipped, not force-unified onto the v4 alpha -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
