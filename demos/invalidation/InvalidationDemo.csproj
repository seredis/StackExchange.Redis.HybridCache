<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InvalidationDemo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- project reference for now; becomes the StackExchange.Redis.HybridCache package when
         this demo relocates to the demos repo -->
    <ProjectReference Include="..\..\src\StackExchange.Redis.HybridCache\StackExchange.Redis.HybridCache.csproj" />

    <!-- the stock stack, so both modes run in one process. Its StackExchange.Redis dependency
         is a >= 2.7.27 floor, so the graph unifies onto the v4 alpha above - a combination
         that has been verified working (stock RedisCache + DefaultHybridCache on v4) -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
