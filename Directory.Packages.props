<Project>
  <ItemGroup>
    <!-- the client; client-side caching (CLIENT TRACKING) is v4-only -->
    <PackageVersion Include="StackExchange.Redis" Version="4.0.161-alpha" />

    <!-- the HybridCache abstract class, entry options/flags, and serializer interfaces
         all live in the abstractions package: we implement the contract without
         referencing Microsoft.Extensions.Caching.Hybrid (the DefaultHybridCache package) -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />

    <!-- downlevel (netstandard2.0) -->
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />

    <!-- analyzers / build -->
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />

    <!-- tests -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <!-- the REAL stock stack, for mixed-mode behaviour probes (deliberately not our packages;
         note these bring a transitive StackExchange.Redis 2.x, isolated to that test project) -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="protobuf-net.HybridCache" Version="3.4.40" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
  </ItemGroup>
</Project>
