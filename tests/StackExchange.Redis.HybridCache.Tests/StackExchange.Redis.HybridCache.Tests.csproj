<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- signed with the shared key so the (signed) library can grant InternalsVisibleTo -->
    <SignAssembly>true</SignAssembly>
    <!-- xUnit1051: suites ported from dotnet/extensions predate TestContext token plumbing -->
    <NoWarn>$(NoWarn);xUnit1051;CA1852</NoWarn><!-- CA1852: TypeTests deliberately uses unsealed types -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StackExchange.Redis.HybridCache\StackExchange.Redis.HybridCache.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- the REAL default implementation, for envelope byte-compatibility tests -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <!-- third-party serializer hooks (IHybridCacheSerializerFactory), for resolution-chain tests -->
    <PackageReference Include="protobuf-net.HybridCache" />
  </ItemGroup>
</Project>
